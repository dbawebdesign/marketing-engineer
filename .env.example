# Postgres. The migration user owns the schema; the app user is subject to RLS.
DATABASE_URL=postgres://me_app_login:change-me@localhost:5432/me
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/me

# 32-byte key, base64. Used for AES-256-GCM encryption of tenant embed secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Public base URL of this deployment (used for embed + links)
APP_URL=http://localhost:3000

# Claude. Without a key the platform runs agents with a deterministic offline engine (dev/demo only).
ANTHROPIC_API_KEY=
ME_MODEL_DEEP=claude-opus-5-5
ME_MODEL_FAST=claude-sonnet-5-5

# Optional: Redis for distributed rate limiting. Falls back to in-process limits.
REDIS_URL=

# Number of reverse proxies in front of the app (0 = ignore X-Forwarded-For; set 1 behind one load balancer).
TRUSTED_PROXY_COUNT=0
# Agent runs a workspace may start per 24 hours, and concurrent jobs per workspace.
ME_DAILY_RUN_LIMIT=100
ME_TENANT_CONCURRENCY=2
