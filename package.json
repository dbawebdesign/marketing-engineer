  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.3",
    "geist": "^1.9.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2",
      "sharp",
      "unrs-resolver"
